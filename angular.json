{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "politechnews": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/politechnews",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "assets", "output": "assets" },
              { "glob": "noticias.json", "input": "data", "output": "data" }
            ],
            "styles": ["styles.css", "src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "750kB" }],
              "optimization": { "scripts": true, "styles": true, "fonts": false },
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "politechnews:build:production" },
            "development": { "buildTarget": "politechnews:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
